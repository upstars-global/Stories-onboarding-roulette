  data() {
    return { items: [] };
  },
};

// Не используй глубокую вложенность в SCSS
.component {
  .nested {
    .deeply {
      .nested {
        // слишком глубоко!
      }
    }
  }
}
```

### ✅ Используй

```typescript
// Типизируй все
const data: ApiResponse = response.data;

// Типизируй ref
const items = ref<Item[]>([]);

// Используй Composition API
